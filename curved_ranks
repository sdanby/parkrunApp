CREATE MATERIALIZED VIEW IF NOT EXISTS public.mv_best_curve
TABLESPACE pg_default
AS
 WITH best_per_athlete AS (
         SELECT DISTINCT ON (r.athlete_code) r.event_code,
            r.event_date,
            r.athlete_code,
            r."position",
            r.name,
            r.age_group,
            r.age_grade,
            r.club,
            r.comment,
            r."time",
            r.time_seconds,
            r.age_ratio_male,
            r.age_ratio_sex,
            r.coeff,
            r.coeff_event,
            r.event_name,
            r.season_adj_time_seconds,
            r.event_adj_time_seconds,
            r.age_adj_time_seconds,
            r.sex_adj_time_seconds,
            r.age_event_adj_time_seconds,
            r.age_sex_adj_time_seconds,
            r.sex_event_adj_time_seconds,
            r.age_sex_event_adj_time_seconds,
            r.season_adj_time,
            r.event_adj_time,
            r.age_adj_time,
            r.sex_adj_time,
            r.age_event_adj_time,
            r.age_sex_adj_time,
            r.sex_event_adj_time,
            r.age_sex_event_adj_time
           FROM mv_extend_runs r
          ORDER BY r.athlete_code, r.time_seconds, r."position", (to_date(r.event_date::text, 'DD/MM/YYYY'::text)) DESC, r.event_code
        )
 SELECT event_code,
    event_date,
    athlete_code,
    "position",
    name,
    age_group,
    age_grade,
    club,
    comment,
    "time",
    time_seconds,
    age_ratio_male,
    age_ratio_sex,
    coeff,
    coeff_event,
    event_name,
    season_adj_time_seconds,
    event_adj_time_seconds,
    age_adj_time_seconds,
    sex_adj_time_seconds,
    age_event_adj_time_seconds,
    age_sex_adj_time_seconds,
    sex_event_adj_time_seconds,
    age_sex_event_adj_time_seconds,
    season_adj_time,
    event_adj_time,
    age_adj_time,
    sex_adj_time,
    age_event_adj_time,
    age_sex_adj_time,
    sex_event_adj_time,
    age_sex_event_adj_time,
    100 - floor(100::double precision * power(percent_rank() OVER (ORDER BY time_seconds, athlete_code), (ln(0.01) / ln(50.0 / NULLIF(count(*) OVER (), 0)::numeric))::double precision))::integer AS rank
   FROM best_per_athlete b
  ORDER BY time_seconds, athlete_code
WITH DATA;

